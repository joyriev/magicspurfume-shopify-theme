ent(1.4px 1.4px at 78% 30%, #fdf3d8, transparent),\n      radial-gradient(1.2px 1.2px at 88% 72%, #ffffff, transparent),\n      radial-gradient(1.5px 1.5px at 8% 82%, #ffffff, transparent),\n      radial-gradient(1.3px 1.3px at 52% 88%, #fdf3d8, transparent);\n    animation:ts-tw 4.2s ease-in-out infinite;\n  }\n  .ts-star-hero .ts-stars2{\n    background-image:\n      radial-gradient(1px 1px at 18% 40%, #ffffff, transparent),\n      radial-gradient(1px 1px at 36% 82%, #ffffff, transparent),\n      radial-gradient(1px 1px at 55% 26%, #fdf3d8, transparent),\n      radial-gradient(1px 1px at 70% 62%, #ffffff, transparent),\n      radial-gradient(1px 1px at 84% 18%, #ffffff, transparent),\n      radial-gradient(1px 1px at 94% 46%, #fdf3d8, transparent),\n      radial-gradient(1px 1px at 4% 54%, #ffffff, transparent);\n    opacity:.75;\n    animation:ts-tw 6.5s ease-in-out infinite reverse;\n  }\n  .ts-star-hero .ts-stars3{\n    background-image:\n      radial-gradient(0.8px 0.8px at 24% 12%, #cfd6ff, transparent),\n      radial-gradient(0.8px 0.8px at 48% 60%, #cfd6ff, transparent),\n      radial-gradient(0.8px 0.8px at 66% 8%, #cfd6ff, transparent),\n      radial-gradient(0.8px 0.8px at 82% 84%, #cfd6ff, transparent),\n      radial-gradient(0.8px 0.8px at 14% 66%, #cfd6ff, transparent);\n    opacity:.55;\n    animation:ts-tw 9s ease-in-out infinite;\n  }\n\n  .ts-star-hero .ts-spark{\n    position:absolute;\n    width:2px;height:2px;border-radius:50%;\n    background:#fff;\n    box-shadow:0 0 6px 1px rgba(255,255,255,0.9), 0 0 12px 3px rgba(201,169,97,0.5);\n    pointer-events:none;\n    animation:ts-pulse 3.4s ease-in-out infinite;\n  }\n  .ts-star-hero .ts-spark.s1{top:26%;left:20%;animation-delay:.2s}\n  .ts-star-hero .ts-spark.s2{top:66%;left:76%;animation-delay:1.1s}\n  .ts-star-hero .ts-spark.s3{top:20%;left:70%;animation-delay:2s}\n  .ts-star-hero .ts-spark.s4{top:74%;left:30%;animation-delay:.8s}\n\n  .ts-star-hero .ts-inner{\n    position:relative;\n    z-ind