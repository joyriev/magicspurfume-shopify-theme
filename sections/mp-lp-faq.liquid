{%- comment -%} MP LP · FAQ (accordion, blocks). Answer A7 carries the {count} token. {%- endcomment -%}
{%- liquid
  assign bg_class = ''
  if section.settings.background == 'cream'
    assign bg_class = ' mp-section--cream'
  elsif section.settings.background == 'cream2'
    assign bg_class = ' mp-section--cream2'
  endif
-%}
<div class="mp-lp">
<section class="mp-section{{ bg_class }}" id="mp-faq">
  <div class="mp-container">
    <div class="mp-center"><h2>{{ section.settings.heading | escape }}</h2><p class="mp-sub">{{ section.settings.sub | escape }}</p></div>
    <div class="mp-faq">
      {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
      <details{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><p>{% render 'mp-lp-tokens', text: block.settings.answer %}</p></details>
      {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="mp-cta">
      {% render 'mp-lp-cta', button: section.settings.cta_button, url: section.settings.cta_url, micro: section.settings.cta_micro %}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "MP LP · FAQ",
  "tag": "div",
  "class": "mp-lp-wrap",
  "max_blocks": 50,
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "cream2", "label": "Cream 2" } ], "default": "cream" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything else you are wondering" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Straight answers, no fine print." },
    { "type": "text", "id": "cta_button", "label": "CTA button", "default": "Save up to €2 000 buying with Magic Perfume", "info": "Non-breaking space between 2 and 000" },
    { "type": "text", "id": "cta_url", "label": "CTA link", "default": "#mp-picker" },
    { "type": "text", "id": "cta_micro", "label": "CTA micro line", "default": "60 day money back guarantee." }
  ],
  "blocks": [
    { "type": "faq", "name": "FAQ item", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "inline_richtext", "id": "answer", "label": "Answer", "default": "Answer", "info": "Tokens: {count} (used on the catalog question)" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] }
  ],
  "presets": [{
    "name": "MP LP · FAQ",
    "blocks": [
      { "type": "faq", "settings": { "question": "Why are your perfumes so cheap?", "answer": "We put the money into what is in the bottle. No luxury flacon, no special packaging, no expensive shops and no expensive influencer deals, which lets you smell luxurious without blowing your budget.", "open": true } },
      { "type": "faq", "settings": { "question": "Is this an Eau de Toilette?", "answer": "No, it is an Eau de Parfum. It holds 21% fragrance oil. An Eau de Toilette, for example, holds between 5 and 15%." } },
      { "type": "faq", "settings": { "question": "How long does the perfume last?", "answer": "Sprayed on skin it holds 8 to 12 hours and longer, thanks to our formula and the 21% fragrance oil concentration." } },
      { "type": "faq", "settings": { "question": "Does the inspired scent smell different?", "answer": "This scent is inspired by similar fragrance notes and belongs to the same fragrance family." } },
      { "type": "faq", "settings": { "question": "What does 21% perfume mean?", "answer": "It means the content of the bottle holds 21% fragrance oil." } },
      { "type": "faq", "settings": { "question": "How can it be legal?", "answer": "Scent compositions are not protected by intellectual property rights on their own, so they can legally be reproduced." } },
      { "type": "faq", "settings": { "question": "How do I put my box together?", "answer": "Pick any six bottles from the {count} scents above, women’s, men’s or any mix. Every bottle is 50 ml. Once all six slots are full, tap the button and you go straight to checkout." } },
      { "type": "faq", "settings": { "question": "When do you ship?", "answer": "We usually ship on the second working day." } },
      { "type": "faq", "settings": { "question": "What if I want to send it back?", "answer": "Unopened bottles go back within 60 days of delivery. We process the refund within 14 working days of the parcel arriving. Write to hello@magicperfume.co." } }
    ]
  }]
}
{% endschema %}
