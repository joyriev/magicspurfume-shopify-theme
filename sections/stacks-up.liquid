{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <p class="text-center text-[#137c44] font-bold tracking-wider">Wir vs. Original</p>
    <h2 class="text-center text-2xl md:text-4xl font-bold max-w-2xl mx-auto mt-0">{{ section.settings.title }}</h2>
    <div class="grid gap-0 w-full max-w-3xl grid-cols-4 mx-auto">
      <div class="col-span-2 !flex items-end border-0 border-b border-[#12121233] border-solid px-4 py-4 text-sm font-black md:text-base"></div>
      <div class="text-center rounded-t-xl border-0 border-solid border-b border-[#12121233] bg-[#137c44] px-2 md:px-4 py-4">
        <div class="text-sm font-black text-white md:text-base">
          Unsere Düfte
        </div>
        <span class="[display:none] md:inline-block text-xs font-bold text-[#8dffcf] py-1 px-2 rounded-full bg-[#ffffff1a]">19–21 % Konzentration</span>
      </div>
      <div class="flex items-center justify-center rounded-t-xl border-0 border-solid border-b border-[#12121233] px-2 md:px-4 py-4 text-center text-sm font-black md:text-base [overflow-wrap:anywhere]">
        Designermarken
      </div>
      {% for block in section.blocks %}
        {% if block.type == "stack" %}
          <div class="col-span-2 border-0 border-solid border-b border-[#12121233] pr-4 py-4">
            <div class="text-sm font-semibold text-black md:text-base">
              {{ block.settings.stack_heading }}
            </div>
            <div class="text-xs">
              {{ block.settings.stack_subheading }}
            </div>
          </div>
          <div class="flex items-center justify-center [word-break:break-word] border-0 border-solid border-b border-[#12121233] bg-[#137c44] text-white px-4 py-4 text-sm tracking-normal md:text-base ">
            <img
              src="{{ 'check-circle-svgrepo-com.svg' | asset_url }}"
              alt="Check"
              height="40"
              width="40">
          </div>
          <div class="flex items-center justify-center [word-break:break-word] border-0 border-solid border-b border-[#12121233] p-4 py-4 text-sm tracking-normal md:text-base">
            <img
              src="{{ 'times-circle-svgrepo-com.svg' | asset_url }}"
              alt="Check"
              height="40"
              width="40">
          </div>
        {% endif %}
      {% endfor %}
      <div class="col-span-2 !block"></div>
      <div class="rounded-b-xl bg-[#137c44] px-4 py-4 !block"></div>
      <div class="!block"></div>
    </div>
    <div class="max-w-[400px] mx-auto mt-8 flex flex-col gap-6 items-center">
      <a
        href="{{ section.settings.btn_url }}"
        class="no-underline text-white tracking-normal font-medium px-8 py-3 bg-[#137c44] hover:bg-[#02491c] rounded-full text-lg text-center transition-colors w-full block tabs-cta-ripple-animation"
        aria-label="Alle anzeigen">
        {{ section.settings.btn_text }}
      </a>
      <ul class="flex justify-center flex-wrap gap-x-6 gap-y-3 list-unstyled">
        <li class="flex items-center gap-1.5">
          <img
            src="{{ 'sandwatch.svg' | asset_url }}"
            height="16"
            width="auto"
            alt="Icon">
          <span class="leading-none">Hält 12+ Stunden</span>
        </li>

        <li class="flex items-center gap-1.5">
          <img
            src="{{ 'icon-heart.svg' | asset_url }}"
            height="16"
            width="auto"
            alt="Icon">
          <span class="leading-none">Geliebt von 10.000+</span>
        </li>

        <li class="flex items-center gap-1.5">
          <img
            src="{{ 'sheild-star.svg' | asset_url }}"
            height="16"
            width="auto"
            alt="Icon">
          <span class="leading-none">60 Tage Zufriedenheitsgarantie</span>
        </li>

      </ul>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Stacks Up",
    "tag": "section",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Wie MagicPerfume im Vergleich zur Konkurrenz abschneidet"
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text",
        "default": "Alle anzeigen"
      },
      {
        "type": "url",
        "id": "btn_url",
        "label": "Button URL",
        "default": "/collections/all"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "stack",
        "name": "Stack",
        "settings": [
          {
            "type": "text",
            "id": "stack_heading",
            "label": "Stack Heading",
            "default": "Haltbarkeit"
          }, {
            "type": "text",
            "id": "stack_subheading",
            "label": "Stack Subheading",
            "default": "12+ Stunden"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Stacks Up"
      }
    ]
  }
{% endschema %}