{%- comment -%} MP LP · Scent families (gender filter + family tiles; the SVG sprite feeds the picker section's tab icons). {%- endcomment -%}
{%- liquid
  assign bg_class = ''
  if section.settings.background == 'cream'
    assign bg_class = ' mp-section--cream'
  elsif section.settings.background == 'cream2'
    assign bg_class = ' mp-section--cream2'
  endif
-%}
<div class="mp-lp">
<section class="mp-section{{ bg_class }}" id="mp-collections">
  <div class="mp-container mp-center">
    <svg class="mp-sprite" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden">
      <symbol id="mp-ico-gourmand" viewBox="0 0 24 24"><path d="M8 10.5L12 21l4-10.5"/><path d="M7 8.5a5 5 0 0 1 10 0c0 1.4-.6 2-1.8 2H8.8C7.6 10.5 7 9.9 7 8.5z"/><path d="M9.5 10.5l1 3M14.5 10.5l-1 3"/></symbol>
      <symbol id="mp-ico-floral" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2.2"/><ellipse cx="12" cy="6.3" rx="2.6" ry="3.7" transform="rotate(0 12 12)"/><ellipse cx="12" cy="6.3" rx="2.6" ry="3.7" transform="rotate(72 12 12)"/><ellipse cx="12" cy="6.3" rx="2.6" ry="3.7" transform="rotate(144 12 12)"/><ellipse cx="12" cy="6.3" rx="2.6" ry="3.7" transform="rotate(216 12 12)"/><ellipse cx="12" cy="6.3" rx="2.6" ry="3.7" transform="rotate(288 12 12)"/></symbol>
      <symbol id="mp-ico-fresh" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5.5"/><path d="M12 3.5v17M3.5 12h17M6 6l12 12M18 6L6 18"/></symbol>
      <symbol id="mp-ico-woody" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5.2"/><circle cx="12" cy="12" r="1.8"/><path d="M20.5 12h-3.2M13.8 12h-2"/></symbol>
      <symbol id="mp-ico-amber" viewBox="0 0 24 24"><path d="M12 3c1 3 4.6 5.4 4.6 9.4a4.6 4.6 0 0 1-9.2 0c0-1.6.5-2.9 1.4-4 .4 1.3 1.2 2 2.2 2.2C10.6 8 11.2 5.5 12 3z"/><path d="M12 21c-1.7 0-2.6-1.2-2.6-2.4 0-1.3 1.2-2 1.6-3.2.6 1 1.6 1.7 1.6 3.1S13 21 12 21z"/></symbol>
      <symbol id="mp-ico-fruity" viewBox="0 0 24 24"><circle cx="8.5" cy="16" r="3.5"/><circle cx="16.5" cy="15" r="3.5"/><path d="M8.5 12.5c.2-3.5 2.3-6.6 5.5-8.5M16.5 11.5c-.4-3-1.6-5.4-2.5-7.5"/><path d="M14 4c1.6-.4 3.3.2 4.5 1.5-1.5.6-3 .5-4.5-1.5z"/></symbol>
    </svg>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="mp-sub">{{ section.settings.sub | escape }}</p>
    <div class="mp-seg-row"><div class="mp-seg" role="group" aria-label="{{ section.settings.gender_group_label | escape }}"><button class="mp-seg__btn" type="button" data-gender="all" aria-pressed="true">{{ section.settings.gender_all | escape }}</button><button class="mp-seg__btn" type="button" data-gender="F" aria-pressed="false">{{ section.settings.gender_women | escape }}</button><button class="mp-seg__btn" type="button" data-gender="M" aria-pressed="false">{{ section.settings.gender_men | escape }}</button><button class="mp-seg__btn" type="button" data-gender="U" aria-pressed="false">{{ section.settings.gender_unisex | escape }}</button></div></div>
    <div class="mp-colls mp-colls--fam">
      {%- for block in section.blocks -%}
      {%- if block.type == 'family' -%}
      {%- liquid
        assign fam_src = block.settings.image_url
        if block.settings.image != blank
          assign fam_src = block.settings.image | image_url: width: 1200
        elsif fam_src == blank and block.settings.image_asset != blank
          assign fam_src = block.settings.image_asset | asset_url
        endif
      -%}
      <div class="mp-coll mp-fam" data-coll="{{ block.settings.key }}" style="--fam-bg:{{ block.settings.bg | escape }};--fam-ink:{{ block.settings.ink | escape }}" {{ block.shopify_attributes }}><span class="mp-coll__label">{{ block.settings.label | escape }} (<span data-coll-count>0</span>)</span><div class="mp-fam__photo"><img src="{{ fam_src }}" width="800" height="600" alt="{{ block.settings.alt | escape }}" loading="lazy"></div><p class="mp-fam__how">{{ block.settings.how }}</p><p class="mp-fam__split" data-coll-split></p><div class="mp-coll__grid" data-coll-grid></div><a class="mp-btn mp-btn--sm" href="#mp-picker" data-tab-link="{{ block.settings.key }}">{{ block.settings.button | escape }}</a></div>
      {%- endif -%}
      {%- endfor -%}
    </div>
    <p class="mp-colls__note">{% render 'mp-lp-tokens', text: section.settings.note, plain: true %}</p>
    {% render 'mp-lp-cta', pill: section.settings.cta_pill, button: section.settings.cta_button, url: section.settings.cta_url, micro: section.settings.cta_micro %}
  </div>
</section>
</div>

{% schema %}
{
  "name": "MP LP · Scent families",
  "tag": "div",
  "class": "mp-lp-wrap",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "cream2", "label": "Cream 2" } ], "default": "white" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your scent family first" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Not sure what you like? Start with how a scent smells. Tap a family and the picker below shows only those bottles." },
    { "type": "header", "content": "Gender filter" },
    { "type": "text", "id": "gender_group_label", "label": "Gender group aria-label", "default": "Show scents for" },
    { "type": "text", "id": "gender_all", "label": "Gender: all", "default": "All" },
    { "type": "text", "id": "gender_women", "label": "Gender: women", "default": "Women" },
    { "type": "text", "id": "gender_men", "label": "Gender: men", "default": "Men" },
    { "type": "text", "id": "gender_unisex", "label": "Gender: unisex", "default": "Unisex" },
    { "type": "header", "content": "Note" },
    { "type": "text", "id": "note", "label": "Note (below the family grid)", "default": "Most scents sit in two families, so you will meet some bottles twice. Every bottle is 50 ml Eau de Parfum. Six women’s, six men’s or any mix, the price stays {price}.", "info": "Tokens: {price}" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_pill", "label": "CTA pill", "default": "97% of our customers claim Magic Perfume is identical." },
    { "type": "text", "id": "cta_button", "label": "CTA button", "default": "Claim the best deal of your life" },
    { "type": "text", "id": "cta_url", "label": "CTA link", "default": "#mp-picker" },
    { "type": "text", "id": "cta_micro", "label": "CTA micro line", "default": "60 day money back guarantee." }
  ],
  "blocks": [
    { "type": "family", "name": "Family", "settings": [
      { "type": "select", "id": "key", "label": "Family key", "options": [ { "value": "gourmand", "label": "Gourmand" }, { "value": "floral", "label": "Floral" }, { "value": "fresh", "label": "Fresh" }, { "value": "woody", "label": "Woody" }, { "value": "amber", "label": "Amber" }, { "value": "fruity", "label": "Fruity" } ], "default": "gourmand" },
      { "type": "text", "id": "label", "label": "Label", "default": "Gourmand" },
      { "type": "inline_richtext", "id": "how", "label": "How it smells", "default": "Smells like dessert. Vanilla, caramel, cocoa and coffee, warm and sweet. <strong>Best after dark and in the cold months.</strong>" },
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_url", "label": "Photo URL (fallback when no image is picked)" },
      { "type": "text", "id": "image_asset", "label": "Photo asset filename (fallback when no image and no URL)", "default": "mp-lp-family-gourmand.jpg" },
      { "type": "text", "id": "alt", "label": "Photo alt text", "default": "Cinnamon rolls on a wooden board" },
      { "type": "text", "id": "bg", "label": "Background colour (hex)", "default": "#F6E7D8" },
      { "type": "text", "id": "ink", "label": "Ink colour (hex)", "default": "#8B5A2B" },
      { "type": "text", "id": "button", "label": "Button label", "default": "Pick from these" }
    ] }
  ],
  "presets": [{
    "name": "MP LP · Scent families",
    "blocks": [
      { "type": "family", "settings": { "key": "gourmand", "label": "Gourmand", "how": "Smells like dessert. Vanilla, caramel, cocoa and coffee, warm and sweet. <strong>Best after dark and in the cold months.</strong>", "image_url": "", "image_asset": "mp-lp-family-gourmand.jpg", "alt": "Cinnamon rolls on a wooden board", "bg": "#F6E7D8", "ink": "#8B5A2B", "button": "Pick from these" } },
      { "type": "family", "settings": { "key": "floral", "label": "Floral", "how": "Built on flowers. Rose, jasmine and iris, from light and clean to rich and heady. <strong>The classic feminine scent.</strong>", "image_url": "", "image_asset": "mp-lp-family-floral.jpg", "alt": "White jasmine flowers", "bg": "#F9E4EC", "ink": "#B4436C", "button": "Pick from these" } },
      { "type": "family", "settings": { "key": "fresh", "label": "Fresh", "how": "Citrus, sea air and green leaves. Clean, light and easy to wear. <strong>Made for daytime, summer and the office.</strong>", "image_url": "", "image_asset": "mp-lp-family-fresh.jpg", "alt": "Lime slices splashing into water", "bg": "#E1F2E9", "ink": "#1F7A5C", "button": "Pick from these" } },
      { "type": "family", "settings": { "key": "woody", "label": "Woody", "how": "Sandalwood, cedar and vetiver. Dry, calm and grown-up, it sits close to the skin. <strong>Works for women and men alike.</strong>", "image_url": "", "image_asset": "mp-lp-family-woody.jpg", "alt": "Warm wood grain", "bg": "#EDE6DA", "ink": "#6A4B2F", "button": "Pick from these" } },
      { "type": "family", "settings": { "key": "amber", "label": "Warm & spicy", "how": "Amber, resins, cinnamon and pepper. Deep, warm and long lasting, it fills a room. <strong>For nights out and winter.</strong>", "image_url": "", "image_asset": "mp-lp-family-amber.jpg", "alt": "Cinnamon sticks and star anise", "bg": "#FBE6D3", "ink": "#C0561E", "button": "Pick from these" } },
      { "type": "family", "settings": { "key": "fruity", "label": "Fruity", "how": "Opens with fruit: peach, cherry, berries or pear on a sweet or floral base. <strong>Juicy and playful, loved at first spray.</strong>", "image_url": "", "image_asset": "mp-lp-family-fruity.jpg", "alt": "Ripe peaches", "bg": "#FCE4E1", "ink": "#C43D3D", "button": "Pick from these" } }
    ]
  }]
}
{% endschema %}
