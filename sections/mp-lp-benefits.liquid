{%- comment -%} MP LP · Benefits arch + trust cards (tile blocks split left/right around the center bottle image; card blocks in the trust grid below). {%- endcomment -%}
{%- liquid
  assign bg_class = ''
  if section.settings.background == 'cream'
    assign bg_class = ' mp-section--cream'
  elsif section.settings.background == 'cream2'
    assign bg_class = ' mp-section--cream2'
  endif
-%}
<div class="mp-lp">
<section class="mp-section{{ bg_class }} mp-benefits" id="mp-benefits">
  <div class="mp-container mp-center">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="mp-sub">{{ section.settings.sub | escape }}</p>
    <div class="mp-arch">
      <ul class="mp-tiles mp-tiles--l">
        {%- assign tile_i = 0 -%}
        {%- for block in section.blocks -%}
        {%- if block.type == 'tile' -%}
        {%- assign tile_i = tile_i | plus: 1 -%}
        {%- if tile_i <= 3 -%}
        <li class="mp-tile" {{ block.shopify_attributes }}><span class="mp-tile__plus">+</span><h3>{% render 'mp-lp-tokens', text: block.settings.title, plain: true %}</h3><p>{{ block.settings.text | escape }}</p></li>
        {%- endif -%}
        {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="mp-arch__center">
        <span class="mp-arch__ring mp-arch__ring--2"></span>
        <span class="mp-arch__ring mp-arch__ring--1"></span>
        <img data-flacon-index="4" src="" width="240" height="240" alt="{{ section.settings.center_alt | escape }}" loading="lazy">
      </div>
      <ul class="mp-tiles mp-tiles--r">
        {%- assign tile_j = 0 -%}
        {%- for block in section.blocks -%}
        {%- if block.type == 'tile' -%}
        {%- assign tile_j = tile_j | plus: 1 -%}
        {%- if tile_j > 3 -%}
        <li class="mp-tile" {{ block.shopify_attributes }}><span class="mp-tile__plus">+</span><h3>{% render 'mp-lp-tokens', text: block.settings.title, plain: true %}</h3><p>{{ block.settings.text | escape }}</p></li>
        {%- endif -%}
        {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <!-- 9 trust cards (overlap) -->
  <div class="mp-container">
    <div class="mp-trust__wrap" id="mp-trust">
      <div class="mp-center"><h2 style="font-size:20px">{{ section.settings.trust_heading | escape }}</h2><p class="mp-sub" style="margin-top:8px">{{ section.settings.trust_sub | escape }}</p></div>
      <div class="mp-trust__grid" style="margin-top:22px">
        {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
        <div class="mp-tcard" {{ block.shopify_attributes }}><span class="mp-tcard__ico">{%- case block.settings.icon -%}
          {%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
          {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 6.5l.9 2h2.1l-1.7 1.3.6 2-1.9-1.2-1.9 1.2.6-2L9 8.5h2.1z" fill="currentColor" stroke="none"/></svg>
          {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
          {%- endcase -%}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></div>
        {%- endif -%}
        {%- endfor -%}
      </div>
      {% render 'mp-lp-cta', pill: section.settings.cta_pill, button: section.settings.cta_button, url: section.settings.cta_url, micro: section.settings.cta_micro %}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "MP LP · Benefits",
  "tag": "div",
  "class": "mp-lp-wrap",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "cream2", "label": "Cream 2" } ], "default": "cream2" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What a Magic Perfume bottle actually gets you" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Six things that stay the same whichever scents you choose." },
    { "type": "header", "content": "Center image" },
    { "type": "text", "id": "center_alt", "label": "Center image alt text", "default": "A single 50 ml Magic Perfume bottle" },
    { "type": "header", "content": "Trust" },
    { "type": "text", "id": "trust_heading", "label": "Trust heading", "default": "Three things we put in writing" },
    { "type": "text", "id": "trust_sub", "label": "Trust subheading", "default": "No small print games on any of them." },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_pill", "label": "CTA pill", "default": "Save up to €2 000 with Magic Perfume", "info": "Contains a non-breaking space between 2 and 000 (matches source)." },
    { "type": "text", "id": "cta_button", "label": "CTA button", "default": "Build your Scent Wardrobe for 50% off" },
    { "type": "text", "id": "cta_url", "label": "CTA link", "default": "#mp-picker" },
    { "type": "text", "id": "cta_micro", "label": "CTA micro line", "default": "60 day money back guarantee." }
  ],
  "blocks": [
    { "type": "tile", "name": "Arch tile", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Unmatched resemblance", "info": "Tokens: {count}" },
      { "type": "text", "id": "text", "label": "Text", "default": "Confirmed by over 10,000 happy scent lovers." }
    ] },
    { "type": "card", "name": "Trust card", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "drop", "label": "Drop" }, { "value": "star", "label": "Star" }, { "value": "shield", "label": "Shield" } ], "default": "drop" },
      { "type": "text", "id": "title", "label": "Title", "default": "Unmatched resemblance and up to 12 hours longevity" },
      { "type": "text", "id": "text", "label": "Text", "default": "21% perfume oil concentration in every bottle, which delivers." }
    ] }
  ],
  "presets": [{
    "name": "MP LP · Benefits",
    "blocks": [
      { "type": "tile", "settings": { "title": "Unmatched resemblance", "text": "Confirmed by over 10,000 happy scent lovers." } },
      { "type": "tile", "settings": { "title": "Up to 12 hours of wear", "text": "Thanks to 21% fragrance oil in every bottle." } },
      { "type": "tile", "settings": { "title": "{count} scents available", "text": "Bestsellers, classics and discontinued collections you loved, available!" } },
      { "type": "tile", "settings": { "title": "Vegan and cruelty free", "text": "No animal ingredients and no animal testing." } },
      { "type": "tile", "settings": { "title": "Made in Europe", "text": "Made to EU standards. No phthalates, parabens or other harmful chemicals." } },
      { "type": "tile", "settings": { "title": "60 day money back guarantee", "text": "Order it, smell it, live with it, then decide." } },
      { "type": "card", "settings": { "icon": "drop", "title": "Unmatched resemblance and up to 12 hours longevity", "text": "21% perfume oil concentration in every bottle, which delivers." } },
      { "type": "card", "settings": { "icon": "star", "title": "Made in Europe", "text": "Produced with Clean Label Strategy, in the EU under EU cosmetic rules." } },
      { "type": "card", "settings": { "icon": "shield", "title": "60 day money back guarantee", "text": "You have 60 days to send your order back. You don’t like it? You get your money back. No questions asked." } }
    ]
  }]
}
{% endschema %}
