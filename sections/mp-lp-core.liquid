{%- comment -%}
  MP LP · Core (REQUIRED, place it FIRST in the page template, one per page).
  Loads the page CSS/JS and fonts, publishes the store configuration + every JS-owned text as JSON for mp-lp.js,
  renders the bundled data maps (designer-compare renders, product overrides, optional family/brand fallbacks),
  hides the theme header UI/footer on this template when asked, and carries a custom CSS box for theme-specific fixes.
  Copy of the visible sections lives in the other MP LP sections; nothing visible renders here except the a11y skip link.
{%- endcomment -%}
{%- liquid
  assign root_url = routes.root_url
  if root_url == '/'
    assign root_url = ''
  endif
  assign money_sample = 123456 | money
  assign bundle_product = all_products[section.settings.bundle_handle]
-%}
{{ 'mp-lp.css' | asset_url | stylesheet_tag }}
{%- if section.settings.load_google_fonts -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@700;800&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
{%- endif -%}
{%- if section.settings.hide_theme_chrome -%}{%- render 'mp-lp-hide-chrome' -%}{%- endif -%}
{%- if section.settings.custom_css != blank -%}
<style>{{ section.settings.custom_css }}</style>
{%- endif -%}
<script type="application/json" data-mp-config>
{
  "store": {
    "bundleHandle": {{ section.settings.bundle_handle | json }},
    "orderCollection": {{ section.settings.order_collection | json }},
    "fillCollection": {{ section.settings.fill_collection | json }},
    "bundleSize": {{ section.settings.bundle_size | default: 6 }},
    "bestsellerCount": {{ section.settings.bestseller_count | default: 20 }},
    "shipCents": {{ section.settings.ship_cents | default: 549 }},
    "variantTitle": {{ section.settings.variant_title | json }},
    "titlePrefixRegex": {{ section.settings.title_prefix_regex | json }},
    "excludeHandlesRegex": {{ section.settings.exclude_handles_regex | json }},
    "excludeTags": {{ section.settings.exclude_tags | json }},
    "tagWomen": {{ section.settings.tag_women | json }},
    "tagMen": {{ section.settings.tag_men | json }},
    "tagUnisex": {{ section.settings.tag_unisex | json }},
    "tagNew": {{ section.settings.tag_new | json }},
    "familyPrefix": {{ section.settings.family_prefix | json }},
    "brandPrefix": {{ section.settings.brand_prefix | json }},
    "afterAdd": {{ section.settings.after_add | json }},
    "giftWaitMs": {{ section.settings.gift_wait_ms | default: 0 }},
    "itemLabel": {{ section.settings.item_label | json }},
    "itemText": {{ section.settings.item_text | json }},
    "dataSource": {{ section.settings.data_source | json }},
    "previewUrl": {{ section.settings.preview_asset | asset_url | json }},
    "rotatorIntervalMs": {{ section.settings.rotator_interval | default: 3000 }},
    "cardsPerPage": {{ section.settings.cards_per_page | default: 12 }},
    "bundleVariantFallback": {{ section.settings.bundle_variant_fallback | default: 0 }}
  },
  "routes": {
    "root": {{ root_url | json }},
    "collections": {{ routes.collections_url | json }},
    "cartAdd": {{ routes.cart_add_url | json }},
    "cart": {{ routes.cart_url | json }},
    "checkout": {{ root_url | append: '/checkout' | json }}
  },
  "money": {
    "format": {{ shop.money_format | json }},
    "override": {{ section.settings.money_format | json }},
    "sample": {{ money_sample | strip_html | json }},
    "sampleCents": 123456
  },
  "bundle": {% if bundle_product != blank and bundle_product.selected_or_first_available_variant %}{ "variantId": {{ bundle_product.selected_or_first_available_variant.id }}, "price": {{ bundle_product.price }}, "compareAtPrice": {{ bundle_product.compare_at_price | default: 0 }}, "available": {{ bundle_product.available }} }{% else %}null{% endif %},
  "text": {
    "showingAll": {{ section.settings.t_showing_all | json }},
    "showingPart": {{ section.settings.t_showing_part | json }},
    "moreOne": {{ section.settings.t_more_one | json }},
    "moreMany": {{ section.settings.t_more_many | json }},
    "add": {{ section.settings.t_add | json }},
    "added": {{ section.settings.t_added | json }},
    "soldOut": {{ section.settings.t_sold_out | json }},
    "cardMeta": {{ section.settings.t_card_meta | json }},
    "cardAlt": {{ section.settings.t_card_alt | json }},
    "flaconAlt": {{ section.settings.t_flacon_alt | json }},
    "smellsLike": {{ section.settings.t_smells_like | json }},
    "badgeNew": {{ section.settings.t_badge_new | json }},
    "badgeBest": {{ section.settings.t_badge_best | json }},
    "chooseOne": {{ section.settings.t_choose_one | json }},
    "chooseMany": {{ section.settings.t_choose_many | json }},
    "full": {{ section.settings.t_full | json }},
    "picked": {{ section.settings.t_picked | json }},
    "unlockPending": {{ section.settings.t_unlock_pending | json }},
    "unlockDone": {{ section.settings.t_unlock_done | json }},
    "bonusLocked": {{ section.settings.t_bonus_locked | json }},
    "bonusUnlocked": {{ section.settings.t_bonus_unlocked | json }},
    "emptySlot": {{ section.settings.t_empty_slot | json }},
    "removeChip": {{ section.settings.t_remove_chip | json }},
    "ctaDisabled": {{ section.settings.t_cta_disabled | json }},
    "ctaActive": {{ section.settings.t_cta_active | json }},
    "ctaLoading": {{ section.settings.t_cta_loading | json }},
    "searchPart": {{ section.settings.t_search_part | json }},
    "searchOne": {{ section.settings.t_search_one | json }},
    "searchMany": {{ section.settings.t_search_many | json }},
    "searchNone": {{ section.settings.t_search_none | json }},
    "searchNoneHere": {{ section.settings.t_search_none_here | json }},
    "searchIn": {{ section.settings.t_search_in | json }},
    "searchForWomen": {{ section.settings.t_search_for_women | json }},
    "searchForMen": {{ section.settings.t_search_for_men | json }},
    "searchForUnisex": {{ section.settings.t_search_for_unisex | json }},
    "showAllOne": {{ section.settings.t_show_all_one | json }},
    "showAllMany": {{ section.settings.t_show_all_many | json }},
    "clearSearch": {{ section.settings.t_clear_search | json }},
    "famGourmand": {{ section.settings.t_fam_gourmand | json }},
    "famFloral": {{ section.settings.t_fam_floral | json }},
    "famFresh": {{ section.settings.t_fam_fresh | json }},
    "famWoody": {{ section.settings.t_fam_woody | json }},
    "famAmber": {{ section.settings.t_fam_amber | json }},
    "famFruity": {{ section.settings.t_fam_fruity | json }},
    "genderWomen": {{ section.settings.t_gender_women | json }},
    "genderMen": {{ section.settings.t_gender_men | json }},
    "genderUnisex": {{ section.settings.t_gender_unisex | json }},
    "split": {{ section.settings.t_split | json }},
    "splitUnisex": {{ section.settings.t_split_unisex | json }},
    "nWomen": {{ section.settings.t_n_women | json }},
    "nMen": {{ section.settings.t_n_men | json }},
    "nUnisex": {{ section.settings.t_n_unisex | json }},
    "noneTileWomen": {{ section.settings.t_none_tile_women | json }},
    "noneTileMen": {{ section.settings.t_none_tile_men | json }},
    "noneTileUnisex": {{ section.settings.t_none_tile_unisex | json }},
    "noneGrid": {{ section.settings.t_none_grid | json }},
    "adjWomen": {{ section.settings.t_adj_women | json }},
    "adjMen": {{ section.settings.t_adj_men | json }},
    "adjUnisex": {{ section.settings.t_adj_unisex | json }},
    "thisFamily": {{ section.settings.t_this_family | json }},
    "reviewsDot": {{ section.settings.t_reviews_dot | json }},
    "loadError": {{ section.settings.t_load_error | json }},
    "unavailable": {{ section.settings.t_unavailable | json }}
  }
}
</script>
{%- if section.settings.use_bundled_maps -%}{%- render 'mp-lp-data-magicperfume', fallback_maps: section.settings.use_fallback_maps -%}{%- endif -%}
<div class="mp-lp mp-lp--core"><a class="mp-skip" href="#mp-picker">{{ section.settings.skip_label | escape }}</a></div>
<script src="{{ 'mp-lp.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "MP LP · Core (required)",
  "tag": "div",
  "class": "mp-lp-wrap mp-lp-wrap--core",
  "limit": 1,
  "settings": [
    { "type": "paragraph", "content": "Place this section first. It loads the page styles and script and holds every setting the picker needs. Copy of the visible sections is edited in the sections below it." },
    { "type": "header", "content": "Store" },
    { "type": "text", "id": "bundle_handle", "label": "Bundle product handle", "default": "6-x-50ml-parfumflaschen-5999", "info": "The six-pack product the box is added as. Its price and compare-at price feed every price on the page." },
    { "type": "text", "id": "order_collection", "label": "Order collection handle", "default": "best-sellers", "info": "Sales order of the picker. Its first products get the Bestseller badge." },
    { "type": "text", "id": "fill_collection", "label": "Fill collection handle", "default": "all", "info": "Every perfume missing from the order collection is appended from here." },
    { "type": "range", "id": "bundle_size", "label": "Bottles per box", "min": 2, "max": 12, "step": 1, "default": 6, "info": "The copy of the page is written for six." },
    { "type": "range", "id": "bestseller_count", "label": "Bestseller badges (top N)", "min": 0, "max": 50, "step": 1, "default": 20 },
    { "type": "number", "id": "ship_cents", "label": "Shipping price shown as struck through, in cents", "default": 549 },
    { "type": "text", "id": "variant_title", "label": "Variant title of the single bottle", "default": "50ml", "info": "Compared without spaces, case-insensitive." },
    { "type": "number", "id": "bundle_variant_fallback", "label": "Bundle variant id (fallback)", "default": 48445769122050, "info": "Used only while the bundle product cannot be read (e.g. still a draft). Normally the product handle above is enough." },
    { "type": "text", "id": "money_format", "label": "Price format override", "info": "Empty = the shop's own format (e.g. 59,99 €). Otherwise text with one placeholder: €{amount_comma} shows €59,99; {amount} € shows 59.99 €; {amount_no_decimals} rounds." },
    { "type": "header", "content": "Catalogue rules" },
    { "type": "text", "id": "title_prefix_regex", "label": "Title prefix to strip (regex)", "default": "^\\s*(duftet|riecht|smells)\\s+(wie|like)\\s*(\\.\\.\\.|…)?\\s*", "info": "Products whose title starts with this get the 'Smells like' card label; the prefix is removed from the name." },
    { "type": "text", "id": "exclude_handles_regex", "label": "Exclude handles matching (regex)", "default": "mystik|gift-card|versand|garantie|geschenk|versicherung|parfumfuhrer|schatz" },
    { "type": "text", "id": "exclude_tags", "label": "Exclude products with tag", "default": "bundle", "info": "Comma separated. Products of type Bundle are excluded always." },
    { "type": "text", "id": "tag_women", "label": "Tag: for women", "default": "fuer-frauen" },
    { "type": "text", "id": "tag_men", "label": "Tag: for men", "default": "fuer-maenner" },
    { "type": "text", "id": "tag_unisex", "label": "Tag: unisex", "default": "unisex" },
    { "type": "text", "id": "tag_new", "label": "Tag: new", "default": "new" },
    { "type": "text", "id": "family_prefix", "label": "Scent family tag prefix", "default": "family:", "info": "family:gourmand, family:floral, family:fresh, family:woody, family:amber, family:fruity" },
    { "type": "text", "id": "brand_prefix", "label": "Brand tag prefix", "default": "marke:", "info": "marke:dior, marke:tom-ford … used by the search." },
    { "type": "header", "content": "After the sixth bottle" },
    { "type": "select", "id": "after_add", "label": "What happens after add to cart", "options": [ { "value": "drawer", "label": "Open the theme cart drawer (Dawn)" }, { "value": "cart", "label": "Go to the cart page" }, { "value": "checkout", "label": "Go straight to checkout" } ], "default": "drawer", "info": "Drawer lets the Free Gift app and the free-shipping bar run. Falls back to the cart page when the theme has no drawer." },
    { "type": "range", "id": "gift_wait_ms", "label": "Checkout mode: wait for the gift line (ms)", "min": 0, "max": 8000, "step": 500, "default": 2500 },
    { "type": "text", "id": "item_label", "label": "Line item property label per bottle", "default": "Flasche", "info": "Fulfilment reads these: Flasche 1 … Flasche 6." },
    { "type": "text", "id": "item_text", "label": "Line item property text per bottle", "default": "{name} Inspiriert von {inspiration} - 50ml", "info": "Tokens: {name} {inspiration} {number}" },
    { "type": "header", "content": "Data source" },
    { "type": "select", "id": "data_source", "label": "Catalogue source", "options": [ { "value": "store", "label": "Store (collections JSON, live)" }, { "value": "preview", "label": "Preview snapshot asset" } ], "default": "store", "info": "Preview renders the page on a store without the catalogue (design review)." },
    { "type": "text", "id": "preview_asset", "label": "Preview snapshot asset", "default": "mp-lp-preview-catalog.json" },
    { "type": "checkbox", "id": "use_bundled_maps", "label": "Use bundled data maps (designer-compare renders, product overrides)", "default": true },
    { "type": "checkbox", "id": "use_fallback_maps", "label": "Also use the bundled family and brand maps", "default": false, "info": "Only for a store whose products carry no family: / marke: tags yet." },
    { "type": "range", "id": "rotator_interval", "label": "Headline rotation (ms)", "min": 1500, "max": 8000, "step": 500, "default": 3000 },
    { "type": "range", "id": "cards_per_page", "label": "Scent cards per page", "min": 6, "max": 48, "step": 6, "default": 12 },
    { "type": "header", "content": "Page chrome" },
    { "type": "checkbox", "id": "hide_theme_chrome", "label": "Hide the theme header UI and footer on this page", "default": true, "info": "CSS only, on this template. The header stays in the page so the cart drawer keeps working." },
    { "type": "checkbox", "id": "load_google_fonts", "label": "Load Figtree + Plus Jakarta Sans from Google Fonts", "default": true },
    { "type": "text", "id": "skip_label", "label": "Skip link (screen readers)", "default": "Skip to the scent picker" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "info": "Theme-specific fixes, e.g. selectors of a non-Dawn header to hide." },
    { "type": "header", "content": "Picker texts" },
    { "type": "text", "id": "t_showing_all", "label": "Count, all shown", "default": "Showing {total} scents", "info": "Tokens: {total}" },
    { "type": "text", "id": "t_showing_part", "label": "Count, part shown", "default": "Showing {n} of {total} scents", "info": "Tokens: {n} {total}" },
    { "type": "text", "id": "t_more_one", "label": "Show more (one)", "default": "Show 1 more scent" },
    { "type": "text", "id": "t_more_many", "label": "Show more (many)", "default": "Show {n} more scents", "info": "Tokens: {n}" },
    { "type": "text", "id": "t_add", "label": "Card button", "default": "Add" },
    { "type": "text", "id": "t_added", "label": "Card button, selected", "default": "Added" },
    { "type": "text", "id": "t_sold_out", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "t_card_meta", "label": "Card meta line", "default": "50 ml Eau de Parfum" },
    { "type": "text", "id": "t_card_alt", "label": "Card image alt", "default": "Magic Perfume {number}, 50 ml", "info": "Tokens: {number}" },
    { "type": "text", "id": "t_flacon_alt", "label": "Decorative bottle alt", "default": "Magic Perfume bottle {number}", "info": "Tokens: {number}" },
    { "type": "text", "id": "t_smells_like", "label": "Card name prefix", "default": "Smells like {name}", "info": "Tokens: {name}" },
    { "type": "text", "id": "t_badge_new", "label": "Badge: new", "default": "New" },
    { "type": "text", "id": "t_badge_best", "label": "Badge: bestseller", "default": "Bestseller" },
    { "type": "header", "content": "Tray texts" },
    { "type": "text", "id": "t_choose_one", "label": "Counter, one left", "default": "Choose 1 more" },
    { "type": "text", "id": "t_choose_many", "label": "Counter, many left", "default": "Choose {n} more", "info": "Tokens: {n}" },
    { "type": "text", "id": "t_full", "label": "Counter, full", "default": "Your box is full" },
    { "type": "text", "id": "t_picked", "label": "Progress label", "default": "{n} of {max} picked", "info": "Tokens: {n} {max}" },
    { "type": "text", "id": "t_unlock_pending", "label": "Progress note, pending", "default": "Both unlock with the full box" },
    { "type": "text", "id": "t_unlock_done", "label": "Progress note, done", "default": "Both bonuses unlocked" },
    { "type": "text", "id": "t_bonus_locked", "label": "Bonus tile, locked", "default": "Unlocks with the full box" },
    { "type": "text", "id": "t_bonus_unlocked", "label": "Bonus tile, unlocked", "default": "Unlocked, in your box" },
    { "type": "text", "id": "t_empty_slot", "label": "Empty slot (screen readers)", "default": "Empty slot" },
    { "type": "text", "id": "t_remove_chip", "label": "Remove button (screen readers)", "default": "Remove {name} from your box", "info": "Tokens: {name}" },
    { "type": "text", "id": "t_cta_disabled", "label": "Button, not enough bottles", "default": "Pick {max} bottles to continue", "info": "Tokens: {max}" },
    { "type": "text", "id": "t_cta_active", "label": "Button, ready", "default": "Add to cart, {price} →", "info": "Tokens: {price}" },
    { "type": "text", "id": "t_cta_loading", "label": "Button, adding", "default": "One moment..." },
    { "type": "header", "content": "Search texts" },
    { "type": "text", "id": "t_search_part", "label": "Matches, part shown", "default": "Showing {n} of {total} matches for “{q}”", "info": "Tokens: {n} {total} {q}" },
    { "type": "text", "id": "t_search_one", "label": "Matches, one", "default": "{total} match for “{q}”", "info": "Tokens: {total} {q}" },
    { "type": "text", "id": "t_search_many", "label": "Matches, many", "default": "{total} matches for “{q}”", "info": "Tokens: {total} {q}" },
    { "type": "text", "id": "t_search_none", "label": "No match at all", "default": "Nothing matches “{q}”. Try the brand or the original scent name.", "info": "Tokens: {q}" },
    { "type": "text", "id": "t_search_none_here", "label": "No match inside the active filters", "default": "Nothing {where} matches “{q}”.", "info": "Tokens: {where} {q}" },
    { "type": "text", "id": "t_search_in", "label": "Filter phrase: family", "default": "in {family}", "info": "Tokens: {family}" },
    { "type": "text", "id": "t_search_for_women", "label": "Filter phrase: women", "default": "for women" },
    { "type": "text", "id": "t_search_for_men", "label": "Filter phrase: men", "default": "for men" },
    { "type": "text", "id": "t_search_for_unisex", "label": "Filter phrase: unisex", "default": "for unisex" },
    { "type": "text", "id": "t_show_all_one", "label": "Show all matches (one)", "default": "Show all {n} match", "info": "Tokens: {n}" },
    { "type": "text", "id": "t_show_all_many", "label": "Show all matches (many)", "default": "Show all {n} matches", "info": "Tokens: {n}" },
    { "type": "text", "id": "t_clear_search", "label": "Clear search", "default": "Clear search" },
    { "type": "header", "content": "Family and gender labels" },
    { "type": "text", "id": "t_fam_gourmand", "label": "Gourmand", "default": "Gourmand" },
