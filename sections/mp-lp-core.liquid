    { "type": "text", "id": "t_gender_men", "label": "Men", "default": "Men" },
    { "type": "text", "id": "t_gender_unisex", "label": "Unisex", "default": "Unisex" },
    { "type": "text", "id": "t_split", "label": "Family tile split", "default": "{f} for women · {m} for men", "info": "Tokens: {f} {m}" },
    { "type": "text", "id": "t_split_unisex", "label": "Family tile split, unisex suffix", "default": " · {u} unisex", "info": "Tokens: {u}" },
    { "type": "text", "id": "t_n_women", "label": "Tile count, women filter", "default": "{n} for women", "info": "Tokens: {n}" },
    { "type": "text", "id": "t_n_men", "label": "Tile count, men filter", "default": "{n} for men", "info": "Tokens: {n}" },
